# Copia este archivo como .env.local y completa los valores. Nunca subas .env.local al repositorio.

# Neon (Postgres). En Vercel se crea sola al conectar la integración de Neon.
DATABASE_URL="postgresql://usuario:clave@ep-xxxx.us-east-2.aws.neon.tech/tropper?sslmode=require"

# Autenticación (Auth.js / Neon Auth)
AUTH_SECRET=""                # openssl rand -base64 32
AUTH_GOOGLE_ID=""             # Google Cloud Console → Credenciales → ID de cliente OAuth
AUTH_GOOGLE_SECRET=""

# Correo transaccional (enlaces de acceso, confirmación de pedido, cobro del saldo)
RESEND_API_KEY=""
EMAIL_FROM="Tropper Creations <pedidos@tu-dominio.co>"

# Fotos de producto y comprobantes de pago
BLOB_READ_WRITE_TOKEN=""
